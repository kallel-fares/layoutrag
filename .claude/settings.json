{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git *)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cd *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(open *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pytest*)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv init*)",
      "Bash(uv venv*)",
      "Bash(uv tree*)",
      "Bash(uv --version)",
      "Bash(uv python *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git remote add*)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv tool install*)",
      "Bash(uv pip *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(brew *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(kill *)",
      "Bash(pkill *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(:(){*)"
    ]
  }
}
